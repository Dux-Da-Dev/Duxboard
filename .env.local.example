# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Project Anonymous Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Project Service Role Key
# This key has admin privileges and should be kept secret.
SUPABASE_SERVICE_ROLE_KEY=

# The public URL of your deployed application
# Used for generating links in emails (invites, password resets)
# Example: http://localhost:3000 or https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=

# Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
